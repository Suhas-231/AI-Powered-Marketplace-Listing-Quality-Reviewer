# ==========================================================
# Marketplace Listing Quality Reviewer - Backend Environment
# ==========================================================

# Application Secret Key
SECRET_KEY=your_secret_key_here

# Database Configuration (MySQL for Production / Local SQLite Fallback)
# Example Hosted MySQL: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=marketplace_reviewer
# Alternatively set full URI:
# SQLALCHEMY_DATABASE_URI=mysql+pymysql://root:password@localhost:3306/marketplace_reviewer

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Deterministic Validation Limits
MAX_TITLE_LENGTH=150
MIN_TITLE_LENGTH=5
MAX_DESC_LENGTH=5000
MIN_DESC_LENGTH=20

# Server & CORS
PORT=5000
CORS_ORIGINS=*
